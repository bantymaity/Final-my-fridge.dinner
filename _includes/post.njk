<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title }} | MyFridgeDinner</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large">
  <link rel="canonical" href="https://www.myfridgedinner.com{{ page.url }}">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="MyFridgeDinner">
  <meta property="og:title" content="{{ title }} | MyFridgeDinner">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  {% if image %}<meta property="og:image" content="{{ image }}">{% endif %}
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,800;1,700&display=swap" rel="stylesheet">
  
  <style>
    :root{--bg:#090d16;--bg2:#0d1929;--bg3:#131c2e;--bg4:#1a2744;--bdr:#22314d;--bdr2:#2d4166;--am:#f59e0b;--amd:#d97706;--aml:#fbbf24;--ama:rgba(245,158,11,.18);--em:#10b981;--ema:rgba(16,185,129,.12);--tx:#f8fafc;--txm:#94a3b8;--txf:#64748b;--sh:0 4px 20px rgba(0,0,0,.5);--shl:0 16px 56px rgba(0,0,0,.7);--sha:0 4px 28px rgba(245,158,11,.28);--rs:8px;--r:14px;--rl:22px;--rxl:32px;--rf:9999px;--eph:cubic-bezier(.25,.46,.45,.94);--esp:cubic-bezier(.34,1.56,.64,1);--sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;--serif:'Playfair Display',Georgia,serif;--nav:66px}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px;-webkit-text-size-adjust:100%}
body{font-family:var(--sans);background:var(--bg);color:var(--tx);line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}
a{color:var(--am);text-decoration:none;transition:color .15s}
a:hover{color:var(--aml)}
a:focus-visible,button:focus-visible{outline:2px solid var(--am);outline-offset:3px;border-radius:3px}
button{cursor:pointer;font-family:var(--sans);border:none;background:none}
input,textarea{font-family:var(--sans)}
ul,ol{list-style:none}
h1,h2,h3,h4{font-family:var(--serif);line-height:1.2;color:var(--tx)}
h1{font-size:clamp(1.85rem,5vw,3rem);font-weight:800}
h2{font-size:clamp(1.4rem,3.5vw,2.1rem);font-weight:700}
h3{font-size:clamp(1.05rem,2.5vw,1.4rem);font-weight:700}
h4{font-size:.98rem;font-weight:700;font-family:var(--sans)}
p{margin-bottom:1rem;color:var(--txm)}
p:last-child{margin-bottom:0}
strong{color:var(--tx);font-weight:600}
.wrap{max-width:1180px;margin:0 auto;padding:0 clamp(14px,4vw,32px)}
[id]{scroll-margin-top:calc(var(--nav) + 12px)}

/* HEADER */
.site-header{background:var(--bg);position:sticky;top:0;z-index:1000;border-bottom:1px solid var(--bdr);box-shadow:0 2px 20px rgba(0,0,0,.55)}
.hdr-inner{max-width:1180px;margin:0 auto;padding:0 clamp(12px,3vw,28px);height:var(--nav);display:flex;align-items:center;gap:10px;position:relative}
.logo{display:flex;align-items:center;gap:9px;text-decoration:none;flex-shrink:0;margin-right:auto}
.logo-icon{font-size:1.65rem;line-height:1;min-width:1.65rem}
.logo-txt{font-family:var(--serif);font-size:1.18rem;font-weight:800;color:var(--tx);white-space:nowrap}
.logo-txt span{color:var(--am)}
.main-nav{display:flex;align-items:center;gap:2px;flex:1;justify-content:flex-end}
.nav-a{color:rgba(248,250,252,.62);font-size:.8rem;font-weight:500;padding:7px 11px;border-radius:var(--rs);transition:color .15s,background .15s;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;min-height:44px}
.nav-a:hover{color:var(--tx);background:rgba(255,255,255,.07)}
.nav-a.on{color:var(--aml);background:rgba(245,158,11,.14);font-weight:600}

/* BLOG */
.feat-art{max-width:860px;margin:0 auto;padding:clamp(40px,6vw,72px) clamp(14px,4vw,32px)}
.feat-tag{display:inline-block;background:rgba(245,158,11,.14);color:var(--aml);font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 12px;border-radius:var(--rf);margin-bottom:14px}
.feat-art h1{font-size:clamp(1.6rem,4.5vw,2.6rem);margin-bottom:14px;color:var(--tx)}
.post-meta{display:flex;flex-wrap:wrap;align-items:center;gap:12px;font-size:.76rem;color:var(--txf);margin-bottom:26px}
.post-img-wrap{width:100%;border-radius:var(--rl);overflow:hidden;aspect-ratio:16/7;margin-bottom:clamp(26px,4vw,44px);background:var(--bg2);position:relative}
.post-img-wrap img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s var(--eph)}
.post-img-wrap:hover img{transform:scale(1.03)}
.art-body p{font-size:clamp(.92rem,2vw,1.01rem);line-height:1.84;color:var(--txm);margin-bottom:1.45rem}
.art-body h2{font-size:clamp(1.18rem,3vw,1.58rem);color:var(--tx);margin:2.4rem 0 .85rem}
.art-body h3{font-size:clamp(1rem,2.5vw,1.22rem);color:var(--tx);margin:1.9rem 0 .7rem}
.art-body blockquote{border-left:4px solid var(--am);padding:13px 20px;margin:1.7rem 0;background:rgba(245,158,11,.07);border-radius:0 var(--rs) var(--rs) 0;font-style:italic;color:var(--aml);font-size:1rem;line-height:1.7}
.art-body ul,.art-body ol{padding-left:0;margin-bottom:1.4rem}
.art-body ul li,.art-body ol li{padding:4px 0 4px 22px;position:relative;color:var(--txm);font-size:.95rem;line-height:1.72}
.art-body ul li::before,.art-body ol li::before{content:'→';position:absolute;left:0;color:var(--am);font-weight:700}

/* CTA BOX */
.tool-cta{background:linear-gradient(135deg,var(--bg2),var(--bg3));border:1px solid var(--bdr2);border-radius:var(--rl);padding:clamp(22px,4vw,34px);text-align:center;margin:clamp(32px,5vw,52px) auto 0;max-width:860px}
.tool-cta h3{color:var(--aml);margin-bottom:8px}
.tool-cta p{font-size:.9rem;margin-bottom:18px;max-width:520px;margin-left:auto;margin-right:auto}
.btn-cta{display:inline-flex;align-items:center;gap:7px;background:var(--am);color:var(--bg);font-weight:700;font-size:.88rem;padding:11px 24px;border-radius:var(--rf);transition:background .15s}
.btn-cta:hover{background:var(--aml);color:var(--bg)}

/* RELATED POSTS GRID */
.more-lbl{font-family:var(--sans);font-size:.73rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--am);text-align:center;margin-bottom:clamp(22px,4vw,34px)}
.blog-grid{display:grid;gap:clamp(14px,3vw,24px);grid-template-columns:repeat(auto-fill,minmax(260px,1fr));max-width:1180px;margin:0 auto;padding:0 clamp(14px,4vw,32px) clamp(44px,7vw,76px)}
.b-card{background:var(--bg3);border-radius:var(--rl);overflow:hidden;border:1px solid var(--bdr);box-shadow:var(--sh);transition:transform .22s,box-shadow .22s}
.b-card:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,0,0,.6),0 0 0 1px rgba(245,158,11,.18)}
.b-img{aspect-ratio:16/9;overflow:hidden;background:var(--bg2);position:relative;display:block}
.b-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s var(--eph)}
.b-card:hover .b-img img{transform:scale(1.05)}
.b-body{padding:clamp(14px,3vw,20px)}
.b-cat{display:inline-block;background:rgba(245,158,11,.12);color:var(--aml);font-size:.67rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 10px;border-radius:var(--rf);margin-bottom:8px}
.b-body h3{font-size:clamp(.97rem,2.4vw,1.12rem);margin-bottom:7px;color:var(--tx);line-height:1.35}
.b-body p{font-size:.84rem;color:var(--txm);margin-bottom:12px;line-height:1.62}
.btn-rd{display:inline-flex;align-items:center;background:none;border:1.5px solid var(--am);color:var(--am);padding:7px 15px;border-radius:var(--rf);font-size:.78rem;font-weight:600;transition:background .15s,color .15s;text-decoration:none;min-height:44px}
.btn-rd:hover{background:var(--am);color:var(--bg)}
.sec-div{height:1px;background:var(--bdr);max-width:860px;margin:clamp(36px,6vw,56px) auto}

/* FOOTER */
.site-foot{background:var(--bg);border-top:1px solid var(--bdr);padding:clamp(32px,5vw,52px) clamp(14px,4vw,32px) clamp(22px,3vw,34px)}
.ft-in{max-width:1180px;margin:0 auto}
.ft-bot{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center;font-size:.78rem}
.ft-bot p{color:rgba(248,250,252,.35);margin:0}
.ft-links{display:flex;gap:16px;flex-wrap:wrap}
.ft-links a{color:rgba(248,250,252,.5)}
.ft-links a:hover{color:var(--aml)}
  </style>
</head>
<body>

  <!-- হেডার সেকশন -->
  <header class="site-header" role="banner">
    <div class="hdr-inner">
      <a class="logo" href="/">
        <span class="logo-icon">🥘</span>
        <span class="logo-txt">MyFridge<span>Dinner</span></span>
      </a>
      <nav class="main-nav">
        <a href="/" class="nav-a">🏠 Generator</a>
        <a href="/blog.html" class="nav-a on">📰 Blog</a>
        <a href="/about.html" class="nav-a">👋 About</a>
        <a href="/contact.html" class="nav-a">✉️ Contact</a>
      </nav>
    </div>
  </header>

  <!-- মূল ব্লগ কন্টেন্ট -->
  <main id="main-content">
    <article class="feat-art">
      {% if category %}<span class="feat-tag">{{ category }}</span>{% endif %}
      <h1>{{ title }}</h1>
      <div class="post-meta">
        <span>✍️ {{ author or "MyFridgeDinner Editorial" }}</span>
        <span>📅 {{ page.date.toDateString() }}</span>
        {% if read_time %}<span>⏱ {{ read_time }}</span>{% endif %}
      </div>

      {% if image %}
      <div class="post-img-wrap">
        <img src="{{ image }}" alt="{{ title }}">
      </div>
      {% endif %}
      
      <!-- আপনার মার্কডাউন লেখাগুলো অটোমেটিক এই ডিভের ভেতরে ঢুকে যাবে -->
      <div class="art-body">
        {{ content | safe }}
      </div>

      <!-- হোমপেজ টুল CTA (ইন্টারনাল লিংকিং) -->
      <div class="tool-cta">
        <h3>🥘 Got Leftovers in Your Fridge Tonight?</h3>
        <p>Turn what you already have into a restaurant-quality meal in seconds with our free zero-waste recipe generator.</p>
        <a href="/" class="btn-cta">Try the Free Recipe Generator →</a>
      </div>
    </article>

    <div class="sec-div"></div>

    <!-- অটোমেটিক RELATED / MORE GUIDES (গুগল ইনডেক্সিংয়ের জন্য) -->
    <section aria-labelledby="more-guides-h2">
      <p id="more-guides-h2" class="more-lbl">🔥 More Zero-Waste Masterclasses</p>
      <div class="blog-grid">
        {% set shown = 0 %}
        {% for post in collections.post | reverse %}
          {% if post.url != page.url and shown < 4 %}
            {% set shown = shown + 1 %}
            <article class="b-card">
              {% if post.data.image %}
              <a href="{{ post.url }}" class="b-img">
                <img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy">
              </a>
              {% endif %}
              <div class="b-body">
                {% if post.data.category %}<span class="b-cat">{{ post.data.category }}</span>{% endif %}
                <h3><a href="{{ post.url }}" style="color:inherit">{{ post.data.title }}</a></h3>
                {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
                <a href="{{ post.url }}" class="btn-rd">Read Guide →</a>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  </main>

  <footer class="site-foot" role="contentinfo">
    <div class="ft-in">
      <div class="ft-bot">
        <p>&copy; 2026 MyFridgeDinner.com &mdash; Zero Waste, Free Forever.</p>
        <div class="ft-links">
          <a href="/">Generator</a>
          <a href="/blog.html">Blog</a>
          <a href="/about.html">About</a>
          <a href="/privacy.html">Privacy</a>
          <a href="/terms.html">Terms</a>
        </div>
      </div>
    </div>
  </footer>

</body>
</html>
