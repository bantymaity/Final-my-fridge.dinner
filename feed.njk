---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>MyFridgeDinner — Zero-Waste Kitchen Masterclasses</title>
    <link>https://www.myfridgedinner.com/</link>
    <description>Science-backed food safety, storage hacks, and zero-waste techniques to stretch your grocery budget.</description>
    <language>en-us</language>
    <atom:link href="https://www.myfridgedinner.com/feed.xml" rel="self" type="application/rss+xml" />
    {% for post in collections.post | reverse %}
    {% if loop.index <= 20 %}
    <item>
      <title>{{ post.data.title | escape }}</title>
      <link>https://www.myfridgedinner.com{{ post.url }}</link>
      <guid>https://www.myfridgedinner.com{{ post.url }}</guid>
      <pubDate>{{ post.date.toUTCString() }}</pubDate>
      {% if post.data.description %}
      <description>{{ post.data.description | escape }}</description>
      {% endif %}
    </item>
    {% endif %}
    {% endfor %}
  </channel>
</rss>
